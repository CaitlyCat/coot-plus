{"app.label_atoms_in_residue_action", "Labels every atom of the centre residue."},
{"app.label_CA_atoms_action", "Labels all CA atoms of the molecule at the screen centre."},
{"app.label_neighbours_action", "Labels the closest atoms of the residues within 4 Å of the centre residue."},
{"app.clear_atom_labels_action", "Removes all atom labels."},
{"app.go_to_atom_action", "Opens the Go To Atom window to jump to a chain, residue or atom."},
{"app.residue_type_selection_action", "Choose a model and type a residue name: copies those residues to a new molecule and lists them as buttons that centre on each."},
{"app.residues_with_alt_confs_action", "Lists the residues with alternative conformations in the molecule at the screen centre; click one to go there."},
{"app.residues_with_cis_peptides_action", "Lists cis, pre-PRO cis and twisted-trans peptides in the molecule at the screen centre; click one to go there."},
{"app.residues_with_missing_atoms_action", "Lists residues with missing atoms (not counting hydrogens) in the molecule at the screen centre, naming the atoms; click one to go there."},
{"app.sequence_view_action", "Opens a sequence view of the molecule at the screen centre."},
{"app.show_shader_preferences_action", "Opens Shader Settings: lighting, material and other drawing options."},
{"app.scene_preset_model_building_action", "Sets the clipping planes for model building (front 1.0, back 1.0)."},
{"app.scene_preset_figure_making_action", "Sets the clipping planes for figures (front 4.5, back 1.3)."},
{"app.distances_and_angles_action", "Opens the Geometry panel: click atoms to measure distances, angles and torsions, or clear them."},
{"app.environment_distances_action", "Turns on contact distances around the centre residue, within the min/max distances you set, optionally labelling atoms."},
{"app.residue_info_action", "Opens Residue Info for the centre residue: its atoms with occupancies and B-factors, which you can edit and apply (Ctrl-I)."},
{"app.HOLE_action", "Opens HOLE: choose a model, set start and end points at the screen centre, and calculate the channel (pore) profile between them."},
{"app.local_b_factors_action", "Labels atoms within 8 Å of the screen centre with their B-factors, and adds a \"Local B-factors\" on/off button to the toolbar."},
{"app.show_validation_graphs_dialog", "Choose a model and chain, then tick graphs: Density fit, Temp. Factor, Ramachandran, Rotamer, Peptide Omega, Geometry, Density Correlation, NCS. One bar per residue; click a bar to go there."},
{"app.validation_outliers_action", "Opens the side panel of outliers in the centre model: overlaps, rotamers, chiral volumes, Ramachandran, cis/twisted peptides, Cβ deviations. Click one to go there."},
{"app.overlaps_peptides_cbeta_ramas_and_rotas_action", "Opens the side panel of outliers in the centre model: overlaps, rotamers, chiral volumes, Ramachandran, cis/twisted peptides, Cβ deviations. Click one to go there."},
{"app.ramachandran_plot_action", "Choose a model to open its Ramachandran plot."},
{"app.difference_map_peaks_action", "Choose a difference map, a model and an r.m.s.d. level: lists positive (and optionally negative) peaks to visit."},
{"app.unmodelled_blobs_action", "Choose a map, a model and a σ level: finds density blobs that the model does not cover."},
{"app.pepflips_from_difference_map_action", "Choose a model and a difference map: lists peptides that the difference density suggests flipping."},
{"app.atoms_overlaps_action", "Draws atom contact dots and overlaps for the molecule at the screen centre, and adds an \"Atom Overlaps\" on/off button to the toolbar."},
{"app.all_atom_contact_dots_molprobity_action", "Runs MolProbity's reduce and probe on the molecule at the screen centre (they must be installed) and draws the contact dots."},
{"app.check_delete_waters_action", "Opens Check Waters: find or delete waters by B-factor, map level and contact distances."},
{"app.atoms_with_zero_occupancies_action", "Lists atoms with zero occupancy in the molecule at the screen centre; click one to go there."},
{"app.command_search_action", "Puts the cursor in the command search box, to find and run menu commands by name."},
{"app.about_coot_action", "Shows the About Coot window."},
{"app.coot_shortcuts_action", "Opens a window listing the keyboard shortcuts."},
{"app.remarks_browser_action", "Choose a model to browse its header (REMARK) records."},
{"app.acedrg_link_interface_action", "Opens the Acedrg Link panel: set the two monomers, linking atoms, bond order and atom changes to make a link dictionary. Needs acedrg on your PATH."},
{"app.run_acedrg_via_CCD_dictionary_download_action", "Downloads the PDBe CCD entry for the centre residue's type and runs acedrg on it in the background to make a dictionary."},
{"app.cryo_em_solidify_maps_action", "Draws every map as a solid surface."},
{"app.cryo_em_unsolidify_maps_action", "Switches every map back from solid surface to mesh."},
{"app.cryo_em_add_molecular_symmetry_mtrix_action", "Adds molecular symmetry from the MTRIX records in the file of the molecule at the screen centre."},
{"app.emplacement_action", "Opens EM Placement: give two half maps, a model and resolution; Phaser places the model at the movable sphere marker (starts at the screen centre)."},
{"app.cryo_em_go_to_box_middle_action", "Moves the view to the middle of the refinement map's box (unit cell)."},
{"app.cryo_em_go_to_middle_of_map_action", "Moves the view to the centre of the refinement map."},
{"app.cryo_em_flip_hand_action", "Choose a map: makes a new copy of it with the opposite hand."},
{"app.cryo_em_make_masked_maps_action", "Makes one new map per chain of the centre model, cut from the refinement map around that chain."},
{"app.cryo_em_make_partitioned_maps_action", "Choose a map and a model: partitions the map into regions by chain."},
{"app.cryo_em_assign_sequence_to_active_fragment_action", "Assigns sequence to the chain at the screen centre using the refinement map."},
{"app.cryo_em_hiranuma_inversion_action", "Converts pLDDT values in the B-factor column of the centre model (e.g. AlphaFold) into B-factors."},
{"app.jiggle_fit_chain_simple_action", "Fits the chain at the screen centre into the refinement map by 4000 random rotation/translation trials."},
{"app.jiggle_fit_molecule_simple_action", "Fits the molecule at the screen centre into the refinement map by 4000 random rotation/translation trials."},
{"app.jiggle_fit_chain_with_fourier_filtering_action", "Fits the chain at the screen centre by 10000 random trials against a blurred (B 300) copy of the refinement map."},
{"app.jiggle_fit_molecule_with_fourier_filtering_action", "Fits the molecule at the screen centre by 4000 random trials against a blurred (B 300) copy of the refinement map."},
{"app.patmos_jiggle_fit_molecule_with_fourier_filtering_action", "Places the centre molecule by a rotation/translation search about the screen centre, then jiggle-fits it (1000 trials) against a blurred map."},
{"app.cryo_em_sharpen_blur_map_action", "Choose a map and a B-factor: makes a sharpened or blurred copy of it, optionally resampled."},
{"app.flev_action", "Opens a 2D diagram of the centre ligand and its surroundings within 4.5 Å."},
{"app.coot_contact_dots_for_ligand_action", "Draws contact dots between the centre residue (e.g. a ligand) and its surroundings."},
{"app.geometric_distortions_for_ligand_action", "Draws the geometric distortions of the centre residue as coloured markers in the graphics."},
{"app.superpose_picked_ligands_action", "Pick one atom in each of two ligands with Range/Pair first (the moving molecule must hold only the ligand): matches torsions and overlays it on the other."},
{"app.show_chemical_features_action", "Shows the chemical features (RDKit) of the centre residue in the graphics."},
{"app.SMILES_to_3D_action", "Type a SMILES string: makes a 3D model of that molecule."},
{"app.generate_self_restraints_chain_3_7_action", "Replaces the extra restraints with distance restraints between atom pairs within 3.7 Å, for the chain at the screen centre."},
{"app.generate_self_restraints_chain_4_3_action", "Replaces the extra restraints with distance restraints between atom pairs within 4.3 Å, for the chain at the screen centre."},
{"app.generate_self_restraints_chain_5_0_action", "Replaces the extra restraints with distance restraints between atom pairs within 5.0 Å, for the chain at the screen centre."},
{"app.generate_self_restraints_chain_6_0_action", "Replaces the extra restraints with distance restraints between atom pairs within 6.0 Å, for the chain at the screen centre."},
{"app.generate_all_molecule_self_restraints_4_3_action", "Replaces the extra restraints with distance restraints between atom pairs within 4.3 Å, for the whole molecule at the screen centre."},
{"app.generate_all_molecule_self_restraints_5_0_action", "Replaces the extra restraints with distance restraints between atom pairs within 5.0 Å, for the whole molecule at the screen centre."},
{"app.generate_all_molecule_self_restraints_6_0_action", "Replaces the extra restraints with distance restraints between atom pairs within 6.0 Å, for the whole molecule at the screen centre."},
{"app.import_restraints_action", "Choose a REFMAC extra-restraints file to add to the molecule at the screen centre."},
{"app.delete_all_extra_restraints_action", "Deletes all extra restraints of the molecule at the screen centre."},
{"kb:step right", "Moves the view a step to the right (D)."},
{"kb:step left", "Moves the view a step to the left (A)."},
{"kb:Auto-fit Rotamer", "Fits the best rotamer of the centre residue into the refinement map; while refining, backrub-fits the moving atoms instead (E or J)."},
{"kb:Triple Refine with Auto-accept", "Real-space refines the centre residue and the residues within 2.2 Å of it, and accepts the result straight away (H)."},
{"kb:spin", "Starts or stops spinning the view (I)."},
{"kb:increase contour level", "Raises the contour level of the scroll-wheel map (+ or =)."},
{"kb:decrease contour level", "Lowers the contour level of the scroll-wheel map (-)."},
{"kb:update go-to atom by position", "Sets the Go To Atom window (and sequence view) to the atom at the screen centre (P)."},
{"kb:Pep-flip", "Flips the peptide at the atom nearest the screen centre; while refining, flips it in the moving atoms (Q)."},
{"kb:Refine Residue Auto-Accept", "Real-space refines only the centre residue and accepts the result straight away (R)."},
{"kb:Zoom out", "Zooms out (N)."},
{"kb:Zoom in", "Zooms in (M)."},
{"kb:Move forward", "Moves the view centre forward, into the screen (W)."},
{"kb:Move backward", "Moves the view centre backward, out of the screen (S)."},
{"kb:Triple Refine", "Real-space refines the centre residue and the residue either side of it (T). Accept or reject the result afterwards."},
{"kb:Edit Chi Angles", "Opens the chi-angle editor for the centre residue (C)."},
{"kb:Rotamer Selection", "Lists the rotamers of the centre residue so you can pick one (Shift-X)."},
{"kb:Rotamer Name to Status Bar", "Shows the rotamer name of the centre residue in the status bar (~)."},
{"kb:Undo Move", "Moves back to the previous screen centre (U)."},
{"kb:Accept Moving Atoms", "Accepts the current refinement or move (Return or Space). With nothing to accept, Space goes to the next residue and Shift-Space to the previous one."},
{"kb:Reject Moving Atoms", "Rejects the current refinement or move (Esc). With nothing to reject, Esc leaves full screen."},
{"kb:Label/Unlabel Active Atom", "Labels or unlabels the atom nearest the screen centre and shows its details in the status bar (L)."},
{"kb:Remove All Atom Labels", "Removes all atom labels (Shift-L)."},
{"kb:Murmuration", "Starts or stops a flocking-birds animation in the 3D view (B). Just for fun."},
{"kb:Add Terminal Residue", "Adds an ALA residue at the chain end nearest the screen centre (Y)."},
{"kb:Fill Partial Residue", "Adds the missing atoms of the centre residue, then refines it and accepts the result (K)."},
{"kb:Delete Sidechain", "Deletes the side chain of the centre residue (Shift-K)."},
{"kb:NCS Other Chain", "Jumps to the same place in the next NCS-related chain, matching the view orientation (O)."},
{"kb:Toggle Display of Last Model", "Shows or hides the last (highest-numbered) model (Shift-A)."},
{"kb:Chain Refine", "Real-space refines the whole chain containing the centre residue (Shift-E)."},
{"kb:JED Flip", "Does a JED flip at the atom nearest the screen centre; while refining, applies it to the moving atoms (Shift-F)."},
{"kb:Reverse JED Flip", "Does a JED flip in the opposite direction at the atom nearest the screen centre; while refining, applies it to the moving atoms (Shift-G)."},
{"kb:Jiggle Fit", "Fits the centre residue into the map by 400 random rotation/translation trials (Shift-J)."},
{"kb:Keyboard Mutate", "Opens a small box: type a single-letter code to mutate the centre residue (Shift-M)."},
{"kb:Bond by Dictionary", "Recalculates the bonds of the molecule at the screen centre and redraws it coloured by chain (Shift-P)."},
{"kb:Display Next Map", "Cycles map display: one map at a time, then none, then all (Shift-Q)."},
{"kb:Undo Symmetry View", "Moves the view from a symmetry copy back to the same spot in the real molecule (Shift-V)."},
{"kb:Clipping Front Expand", "Expands the front clipping (1)."},
{"kb:Clipping Front Reduce", "Reduces the front clipping (2)."},
{"kb:Clipping Back Reduce", "Reduces the back clipping (3)."},
{"kb:Clipping Back Expand", "Expands the back clipping (4)."},
{"kb:Show Display Manager", "Opens the Display Manager (F8)."},
{"kb:Highlight Active Residue", "Briefly flashes an outline around the centre residue (` key)."},
{"kb:Copy Model Molecule", "Makes a copy of the model at the screen centre as a new molecule (Ctrl-C)."},
{"kb:Show Go To Residue Keyboarding Window", "Opens a small box where you type a residue to go to (Ctrl-G)."},
{"kb:Undo", "Undoes the last change to the model (Ctrl-Z)."},
{"kb:Redo", "Redoes the last undone change (Ctrl-Y)."},
{"kb:Residue Info", "Opens Residue Info for the centre residue: atoms with occupancies and B-factors you can edit (Ctrl-I)."},
{"kb:Delete Residue", "Deletes the residue at the screen centre (Ctrl-D)."},
{"kb:Add Water", "Adds a water at the screen centre (Ctrl-W)."},
{"kb:Go To Ligand", "Moves the view to the next ligand (Ctrl-L)."},
{"kb:R/T Left", "Nudges the centre residue left; with Shift, rotates it instead (Ctrl-Left)."},
{"kb:R/T Right", "Nudges the centre residue right; with Shift, rotates it instead (Ctrl-Right)."},
{"kb:R/T Up", "Nudges the centre residue up; with Shift, rotates it instead (Ctrl-Up)."},
{"kb:R/T Down", "Nudges the centre residue down; with Shift, rotates it instead (Ctrl-Down)."},
{"kb:Eigen-Flip", "Flips the centre residue (e.g. a ligand) about its principal (eigen) axes (Ctrl-E)."},
{"kb:Quick Save", "Quick-saves the modified molecules and the session state (Ctrl-S)."},
{"kb:Toggle Validation Panel", "Shows or hides the Ramachandran/validation side panel (Ctrl-B)."},
{"kb:Toggle Alt Conf View", "Cycles through the alt confs of the centre molecule, changing which one is drawn (Ctrl-A)."},
{"kb:Smooth bonds", "Cycles the bond smoothness (1, 2, 3) for all models (Ctrl-F)."},
{"kb:Single-model view: previous model", "For a multi-model molecule within 12 Å of the centre (e.g. docking poses), shows the previous model (Left arrow)."},
{"kb:Single-model view: next model", "For a multi-model molecule within 12 Å of the centre (e.g. docking poses), shows the next model (Right arrow)."},
{"app.phosphorylate_this_residue_action", "Replaces the centre TYR, SER or THR with PTR, SEP or TPO (phosphorylated). Needs a refinement map to be set."},
