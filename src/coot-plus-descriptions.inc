// Coot+ hover descriptions: {key, text}. Each one checked against the source
// (handler / action implementation); controls whose behaviour was unclear have none.
// "centre" = the atom/residue closest to the middle of the screen (Coot's active residue).
// Keys: "tb:<builder id>", "app.<action>", "menu:<builder menu id>", "kb:<key binding description>"

// --- top toolbar / header
{"tb:toolbar_reset_view_button", "Centres on the first displayed model; press again to step to the next one. Zoom and orientation stay the same."},
{"tb:toolbar_display_manager_button", "Opens the Display Manager: show/hide and restyle molecules and maps (F8)."},
{"tb:go_to_atom_button", "Opens the Go To Atom window to jump to a chain, residue or atom."},
{"tb:go_to_ligand_button", "Moves the view to the next ligand, looking at it side-on (Ctrl-L)."},
{"tb:graphics-grab-focus-button", "Gives the keyboard back to the 3D view, so key shortcuts work again."},
{"tb:show_logging_menubutton", "Shows or hides the panel of Coot log messages."},
{"tb:python_scripting_button", "Shows or hides the Python command line."},
{"tb:add_module_menubutton", "Adds an extra menu to the toolbar: CCP4, Cryo-EM, Ligand, Restraints, Refine or Views tools."},
{"app.add_ccp4_module_action", "Adds a CCP4 menu (Acedrg links, Acedrg via CCD) to the toolbar."},
{"app.add_cryo_em_module_action", "Adds a Cryo-EM menu to the toolbar: solidify, mask or partition maps, flip hand, jiggle-fit, sharpen/blur."},
{"app.add_ligand_module_action", "Adds a Ligand menu to the toolbar: contact dots, distortions, superpose, jiggle fit, SMILES to 3D."},
{"app.add_restraints_module_action", "Adds a Restraints menu to the toolbar: self-restraints for a chain or molecule, import or delete extra restraints."},
{"app.add_refine_module_action", "Adds refinement switches to the toolbar: contact dots, GM restraints, Rama spheres and rotamer markers while refining."},
{"app.add_views_module_action", "Adds a Views menu to the toolbar to store, save and play back views."},

